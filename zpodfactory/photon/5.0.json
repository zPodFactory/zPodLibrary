{
    "component_name": "photon",
    "component_version": "5.0",
    "component_type": "linux",
    "component_description": "VMware Photon OS 5.0 (cloud-init, VMware datasource via extraConfig)",
    "component_url": "https://vmware.github.io/photon/",
    "component_download_engine": "https",
    "component_download_file": "https://packages.broadcom.com/photon/5.0/GA/ova/photon-hw15-5.0-dde71ec57.x86_64.ova",
    "component_download_file_checksum": "sha256:32d7f5e831feda7426988973cfa78ab3f450a0a2ba3d2d5184bef8c54f6b8356",
    "component_download_file_size": "307 MB",
    "component_deploy_govc_spec": {
        "DiskProvisioning": "thin",
        "IPAllocationPolicy": "dhcpPolicy",
        "IPProtocol": "IPv4",
        "NetworkMapping": [
            {
                "Name": "None",
                "Network": "{{zpod_portgroup}}"
            }
        ],
        "MarkAsTemplate": false,
        "PowerOn": false,
        "InjectOvfEnv": false,
        "WaitForIP": false,
        "Name": null
    },
    "component_deploy_extra_config": {
        "guestinfo.metadata": {
            "format": "yaml",
            "content": {
                "instance-id": "{{zpod_hostname}}.{{zpod_domain}}",
                "local-hostname": "{{zpod_hostname}}",
                "network": {
                    "version": 2,
                    "ethernets": {
                        "eth0": {
                            "addresses": [
                                "{{zpod_ipaddress}}/{{zpod_netprefix}}"
                            ],
                            "routes": [
                                {
                                    "to": "0.0.0.0/0",
                                    "via": "{{zpod_gateway}}"
                                }
                            ],
                            "nameservers": {
                                "addresses": [
                                    "{{zpod_dns}}"
                                ],
                                "search": [
                                    "{{zpod_domain}}"
                                ]
                            }
                        }
                    }
                }
            }
        },
        "guestinfo.userdata": {
            "format": "cloud-config",
            "content": {
                "fqdn": "{{zpod_hostname}}.{{zpod_domain}}",
                "manage_etc_hosts": true,
                "prefer_fqdn_over_hostname": false,
                "disable_root": false,
                "ssh_pwauth": true,
                "chpasswd": {
                    "expire": false,
                    "users": [
                        {
                            "name": "root",
                            "password": "{{zpod_password}}",
                            "type": "text"
                        }
                    ]
                },
                "ssh_authorized_keys": [
                    "{{zpod_sshkey}}"
                ]
            }
        }
    },
    "component_isnested": false
}
